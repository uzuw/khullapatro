# Generate your own: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3001
# Optional GitHub OAuth; all three product pages work without sign-in.
# Callback URL: http://localhost:3001/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional persistent directory. Default: .cache/KhullaPatro
KHULLAPATRO_CACHE_DIR=

# Defaults: file locally, private Blob on Vercel. Leave blank for automatic selection.
KHULLAPATRO_CACHE_STORAGE=
# Provision by connecting a private Vercel Blob store; keep credentials server-only.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
